{% extends 'base.html.twig' %}

{% block title %}Hello MainController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Hello {% if app.user %}{{ app.user.username }}{% endif %}! ✅</h1>
    {% if app.user %}
    <a href="{{ path('app_logout') }}">Logout</a>
        <a href="/silla">Sillas</a>
        <a href="/mesa">Mesas</a>
    {% if is_granted('ROLE_ADMIN') %}
    <a href="{{ path('app_user_index') }}">Usuarios</a>
    {% endif %}
    {% else %}
    <a href="{{ path('app_login') }}">Login</a>
        <a href="{{ path('app_register') }}">Register</a>
    {% endif %}
    This friendly message is coming from:
    <ul>
        <li>Your controller at <code>C:/Users/Jose/PhpstormProjects/Ap1/Bloque_4/AR1/src/Controller/MainController.php</code></li>
        <li>Your template at <code>C:/Users/Jose/PhpstormProjects/Ap1/Bloque_4/AR1/templates/main/index.html.twig</code></li>
    </ul>
</div>
{% endblock %}
